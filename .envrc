# direnv config for mtga-mcp. Run `direnv allow` once to enable.
#
# Puts the project venv on PATH so `mtga-mcp ...` works directly (no `uv run`), and prints
# a command cheat-sheet on entry.

# --- project venv on PATH -------------------------------------------------------------------
export VIRTUAL_ENV="$(expand_path .venv)"
if [[ -x "$VIRTUAL_ENV/bin/mtga-mcp" ]]; then
    PATH_add "$VIRTUAL_ENV/bin"
else
    log_status "no .venv yet — run 'uv sync' to create it, then 'direnv reload'"
fi

# --- project bin/ on PATH (best-of, best-of-1, best-of-3 launchers) --------------------------
PATH_add "$(expand_path bin)"

# --- command cheat-sheet --------------------------------------------------------------------
cat >&2 <<'EOF'

  mtga-mcp commands  (venv on PATH; or prefix with `uv run`)
  ───────────────────────────────────────────────────────────────────────────
  Data import
    mtga-mcp import [--catalog|--collection|--scryfall|--all]   ingest MTGA + Scryfall
    mtga-mcp import --force-scryfall                            re-download Scryfall bulk
    mtga-mcp export-collection                                 scan MTGA memory (auto-elevates via sudo)
    mtga-mcp import-collection <file>                          load a legacy exporter JSON

  Inventory
    mtga-mcp capture [--force]                                 snapshot wildcards/currency
    mtga-mcp history [--limit N]                               recent wildcard snapshots

  Decks
    mtga-mcp deck import (--file F | --paste | --url U) --name N [--format F --best-of 1|3]
    mtga-mcp deck list                                        list stored decks
    mtga-mcp deck gap "<deck>"                                 cards/wildcards still needed
    mtga-mcp deck best [--best-of 1|3] [--format F]            best deck you can build now
    mtga-mcp deck wizard                                       interactive best-deck picker
    best-of / best-of-1 / best-of-3                            ^ shortcuts (in this dir)
    mtga-mcp deck craft-priority [--format F]                  what to craft to unlock decks
    mtga-mcp deck delete "<deck>"                              remove a stored deck

  MCP server
    mtga-mcp serve                                            run the MCP server over stdio

  DB: ~/.local/share/mtga-mcp/mtga.db
EOF
